@{
    ViewData["Title"] = "Home";
}

<div class="text-center mt-5">
    <h1 class="display-4 mb-4">Employee Management System</h1>
    <p class="lead">Manage employees easily using CRUD operations.</p>

    <div class="mt-4">

        <a asp-controller="Employee"
           asp-action="Index"
           class="btn btn-primary btn-lg me-3">
            View Employees
        </a>

        <a asp-controller="Employee"
           asp-action="AddEmployee"
           class="btn btn-success btn-lg">
            Add New Employee
        </a>

    </div>
</div>