@model CourseVm
@{ ViewData["Title"] = "Edit Course"; }
<div class="card"><h2>@ViewData["Title"]</h2><div asp-validation-summary="All"></div><form method="post">
<input asp-for="CourseId" type="hidden" />
<div class="form-group"><label asp-for="Title"></label><input asp-for="Title" /></div>
<div class="form-group"><label asp-for="DurationDays"></label><input asp-for="DurationDays" type="number" /></div>
<div class="form-group"><label asp-for="Fee"></label><input asp-for="Fee" type="number" step="0.01" /></div>
<div class="form-group"><label asp-for="Level"></label><select asp-for="Level"><option>Beginner</option><option>Intermediate</option><option>Advanced</option></select></div>
<div class="form-group"><label asp-for="IsActive"></label><input asp-for="IsActive" type="checkbox" style="width:auto" /></div>
<button type="submit" class="btn">Save</button> <a class="btn secondary" asp-action="Index">Back</a></form></div>