@model IEnumerable<StudentVm>
@{ ViewData["Title"] = "Students"; }
<div class="card"><h2>Students</h2><p><a class="btn" asp-action="Create">Add Student</a></p><table><thead><tr><th>ID</th><th>Name</th><th>Email</th><th>Phone</th><th>Status</th><th>Join Date</th><th>Action</th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td>@item.StudentId</td><td>@item.FullName</td><td>@item.Email</td><td>@item.Phone</td><td>@item.Status</td><td>@item.JoinDate</td><td class="actions"><a class="btn secondary" asp-action="Edit" asp-route-id="@item.StudentId">Edit</a><a class="btn danger" asp-action="Delete" asp-route-id="@item.StudentId">Delete</a></td></tr> }
</tbody></table></div>