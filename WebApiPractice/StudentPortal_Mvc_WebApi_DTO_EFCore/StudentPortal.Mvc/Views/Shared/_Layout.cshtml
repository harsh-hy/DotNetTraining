<!DOCTYPE html>
<html><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>@ViewData["Title"] - StudentPortal MVC</title><link rel="stylesheet" href="~/css/site.css" /></head>
<body>
<header class="topbar"><div class="container"><h1>StudentPortal MVC</h1><nav>
<a asp-controller="Home" asp-action="Index">Home</a>
<a asp-controller="Students" asp-action="Index">Students</a>
<a asp-controller="Courses" asp-action="Index">Courses</a>
<a asp-controller="Enrollments" asp-action="Index">Enrollments</a>
</nav></div></header>
<main class="container">
@if (TempData["Success"] is string success) { <div class="alert success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert error">@error</div> }
@RenderBody()
</main></body></html>