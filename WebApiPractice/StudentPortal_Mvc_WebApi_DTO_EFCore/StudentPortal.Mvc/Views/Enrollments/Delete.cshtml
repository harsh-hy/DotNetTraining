@model EnrollmentVm
@{ ViewData["Title"] = "Delete Enrollment"; }
<div class="card"><h2>Delete Enrollment</h2><p>Are you sure you want to delete enrollment <strong>#@Model.EnrollmentId</strong>?</p><p>Student: @Model.StudentName (@Model.StudentId)</p><p>Course: @Model.CourseTitle (@Model.CourseId)</p><form method="post"><button type="submit" class="btn danger">Delete</button> <a class="btn secondary" asp-action="Index">Cancel</a></form></div>