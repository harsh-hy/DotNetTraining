@{
    ViewData["Title"] = "Home";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>

    @if (User.Identity.IsAuthenticated)
    {
        <a asp-controller="Todo"
           asp-action="Index"
           class="btn btn-primary btn-lg mt-3">
            Go to My Todos
        </a>
    }
    else
    {
        <p class="mt-3">Please login to manage your todos.</p>
    }
</div>