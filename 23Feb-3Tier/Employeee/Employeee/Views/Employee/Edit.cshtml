@model Employeee.Models.Employee

<h2>Edit Employee</h2>

<form asp-action="Edit">
    <input type="hidden" asp-for="Id" />

    <label>Name</label>
    <input asp-for="Name" />

    <label>Department</label>
    <input asp-for="Department" />

    <label>City</label>
    <input asp-for="City" />

    <button type="submit">Update</button>

</form>